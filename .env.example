# 复制为 .env 后按需修改。默认 fake provider 可离线运行。
SERVICE_NAME=agent-ticket

# LLM: fake (offline) | openai (any OpenAI-compatible endpoint)
# 例：小米 MiMo（OpenAI 兼容）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.6-flash
LLM_FALLBACK_MODELS=mimo-v2.6-pro
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE=0.2
LLM_TEMPERATURE=0.2
# 可选：鉴权头（默认 Authorization: Bearer）；MiMo 也支持 api-key
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer 
# 可选：合并进请求体（MiMo 关闭深度思考，更快更省）
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 阶段 1 起用于调用 mock 业务系统
MOCK_BASE_URL=http://localhost:8100

# 持久化（run checkpoint 与 session）
DB_PATH=data/agent.db

# Agent loop 守卫与失败策略
AGENT_MAX_STEPS=6
AGENT_MAX_REPEATED_TOOL_CALLS=2
AGENT_TOOL_TIMEOUT=5
AGENT_TOOL_ATTEMPTS=2
AGENT_TOOL_BACKOFF=0.2
AGENT_CONTEXT_MAX_TOKENS=6000

# 存储上限（超出按更新时间淘汰最旧记录）
RUN_STORE_LIMIT=500
SESSION_STORE_LIMIT=500

# 并发闸门与成本治理
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_COST_USD=0
LLM_PRICE_PROMPT_PER_1K=0.005
LLM_PRICE_COMPLETION_PER_1K=0.015

# 内存中保留的 trace 数量上限
TRACE_STORE_LIMIT=500

# RAG 检索栈
# EMBEDDING_PROVIDER=hashing | onnx ；VECTOR_STORE=sqlite | pgvector ；RERANKER= (空) | onnx | llm
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL_PATH=
EMBEDDING_DIM=768
VECTOR_STORE=sqlite
PG_DSN=postgresql://postgres:root@localhost:5432/agent_kb
RERANKER=
RERANKER_MODEL_PATH=
# 本地 ONNX 示例：
# EMBEDDING_PROVIDER=onnx
# EMBEDDING_MODEL_PATH=D:/models/onnx-int8/bge-base-zh-v1.5-onnx-int8
# VECTOR_STORE=pgvector
# RERANKER=onnx
# RERANKER_MODEL_PATH=D:/models/onnx-int8/bge-reranker-base-onnx-int8
